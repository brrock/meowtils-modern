{
  "schemaVersion": 1,
  "id": "meowtils",
  "version": "${version}",
  "name": "Meowtils",
  "description": "A modern Fabric port of the Meowtils client and extension platform.",
  "authors": ["femboytatp", "Meowtils contributors"],
  "license": "MIT",
  "environment": "client",
  "mixins": ["meowtils.mixins.json"],
  "entrypoints": {
    "main": ["wtf.tatp.meowtils.MeowtilsSounds"],
    "client": ["wtf.tatp.meowtils.MeowtilsClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.154.0",
    "minecraft": ">=26.2"
  },
  "custom": {
    "meowtils:github": "${github_repo}"
  }
}
